<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- Edge Swarm v2: WEEKLY full desk run (research/swarm/workflows/desk.js via a
         headless `claude -p`), Sunday 3:00 AM PT. Owner-ruled cadence 2026-09-16:
         weekly, NOT daily (~2.5M tokens/run; v1 died on rate ceilings). Flip to daily
         by deleting the Weekday key, then `launchctl bootout` + `bootstrap` (README
         "Cadence"). Kill switch: touch scripts/.halt_swarm_desk. StdOut/StdErr MUST
         stay in ~/Library/Logs — Desktop log paths cause exit-78 spawn failures (TCC,
         memory/feedback_launchd_tcc.md). Versioned copy: research/swarm/launchd/;
         installed copy: ~/Library/LaunchAgents/. -->
    <key>Label</key>
    <string>com.phmex.desk-weekly</string>

    <key>ProgramArguments</key>
    <array>
        <string>/Library/Frameworks/Python.framework/Versions/3.14/bin/python3</string>
        <string>/Users/jonaspenaso/Desktop/Phmex-S/scripts/swarm_desk.py</string>
        <string>--mode</string>
        <string>desk</string>
    </array>

    <key>WorkingDirectory</key>
    <string>/Users/jonaspenaso/Desktop/Phmex-S</string>

    <key>StartCalendarInterval</key>
    <dict>
        <key>Weekday</key>
        <integer>0</integer>
        <key>Hour</key>
        <integer>3</integer>
        <key>Minute</key>
        <integer>0</integer>
    </dict>

    <key>StandardOutPath</key>
    <string>/Users/jonaspenaso/Library/Logs/Phmex-S/desk-weekly.out.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/jonaspenaso/Library/Logs/Phmex-S/desk-weekly.err.log</string>

    <!-- desk/test modes refuse to run unless the checked-out git branch (rev-parse HEAD) equals SWARM_BRANCH -->
    <key>EnvironmentVariables</key>
    <dict>
        <key>SWARM_BRANCH</key>
        <string>main</string>
        <key>PATH</key>
        <string>/Library/Frameworks/Python.framework/Versions/3.14/bin:/Users/jonaspenaso/.local/bin:/usr/local/bin:/usr/bin:/bin</string>
    </dict>

    <key>RunAtLoad</key>
    <false/>
</dict>
</plist>
