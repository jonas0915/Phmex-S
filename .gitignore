.env
__pycache__/
*.pyc
*.pyo
logs/
*.log
.venv/
venv/
docs/fix-proposals/*.md
l2_snapshot.json

# Editor/OS junk + session temp
.DS_Store
.vscode/
.superpowers/
*.pid

# ST2.0 lab runtime artifacts (state/logs/generated proposals)
scripts/st2_lab/champion.json
scripts/st2_lab/.halt
logs/st2_lab*.log
docs/fix-proposals/st2-lab-*.md

# ST2.0 watcher dedup cache (logs/ already ignored above)
.st2_watch_state.json
.dashboard_token

# worktrees created by EnterWorktree (do not track — auto-backup was committing them as gitlinks)
.claude/worktrees/

# Trading control sentinels (runtime state — must never be tracked; auto-backup was committing .daily_loss_override)
.pause_trading
.daily_loss_override
.pause_*
.kill_*
.demote_*
.block_longs_*
# Cycle-counter persistence (rewritten every cycle — tracking it would churn auto-backup)
.bot_cycles.json
.bot_cycles.json.tmp

# owner trade history (wallet addresses in deposit/withdraw files) — not committed pending owner word
research/swarm/kb/owner_trades/api_deposit_list_full.json
research/swarm/kb/owner_trades/api_withdraw_list_full.json
research/swarm/kb/owner_trades/api_ccxt_deposits.json
# swarm v2: raw data copies inside run dirs never go to git
research/swarm/runs/*/screens/*/data*
research/swarm/runs/**/*.pkl
research/swarm/runs/**/*.parquet
# swarm v2 daily maintenance pass: crossing/verdict flags between runs (runtime state, never tracked)
research/swarm/kb/.maint_state.json
